# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (giữ cấu trúc thư mục nhưng bỏ qua file dữ liệu lớn)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models (bỏ qua file model nặng, giữ thư mục)
models/*
